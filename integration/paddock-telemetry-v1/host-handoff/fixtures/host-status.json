{
  "protocol": 2,
  "id": "paddock-demo",
  "revision": 5,
  "catalogueRevision": 2,
  "name": "Timing integration demo",
  "permissions": {
    "browse": true,
    "submit": true,
    "timingResults": true,
    "club": true
  },
  "capabilities": {
    "timing": {
      "versions": [
        1
      ],
      "profile": "/v1/timing/cars/{carId}",
      "sessions": "/v1/timing/sessions",
      "receipt": "/v1/timing/sessions/{sourceId}/{sessionId}",
      "permission": "timingResults",
      "configurationKinds": [
        "current"
      ],
      "maxRequestBytes": 8388608,
      "maxLaps": 50000,
      "maxParticipants": 256,
      "laneBase": 1,
      "durationUnit": "ms",
      "distanceUnit": "m"
    },
    "telemetry": {
      "version": 1,
      "index": "/v1/telemetry/results",
      "permission": "timingResults",
      "changes": "/v1/telemetry/changes",
      "filters": [
        "carId",
        "sourceId",
        "trackId",
        "from",
        "to"
      ],
      "events": "/v1/telemetry/events",
      "status": "/v1/telemetry/status",
      "snapshot": true,
      "pageSize": 100
    }
  }
}
