{
  "name": "slotforge-calculator",
  "version": "0.12.0",
  "description": "SlotForge Telemetry: gearing, motor performance, weight, tyres and lap calculations",
  "author": "theDutchmanJames",
  "private": true,
  "main": "src/main.cjs",
  "license": "SEE LICENSE IN LICENSE",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "electron tests/pages-smoke.cjs",
    "test:workshop-ui": "electron tests/workshop-ui.cjs",
    "test:magnetic-ui": "electron tests/magnetic-ui.cjs",
    "icons": "electron scripts/build-icon.cjs",
    "check": "node scripts/check.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux --config.directories.output=dist/linux",
    "dist:mac": "electron-builder --mac --config.directories.output=dist/mac",
    "test:shell": "electron tests/shell-smoke.cjs",
    "test:paddock-ui": "electron tests/race-ui-smoke.cjs",
    "test:race-analysis-ui": "electron tests/race-analysis-ui.cjs",
    "test:race-progress-ui": "electron tests/race-progress-ui.cjs",
    "test:manual-laps-ui": "electron tests/manual-laps-ui.cjs",
    "test:chassis-ui": "electron tests/chassis-ui.cjs",
    "test:prediction-ui": "electron tests/prediction-ui.cjs",
    "test:driver-feedback-ui": "electron tests/driver-feedback-ui.cjs",
    "test:workbench-ui": "electron tests/workbench-ui.cjs",
    "test:result-folders-ui": "electron tests/result-folders-ui.cjs"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "nl.slotforge.calculator",
    "productName": "SlotForge Telemetry",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE",
      "SOURCE-NOTICES.txt"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "assets/icon.png",
      "identity": "-",
      "notarize": false,
      "artifactName": "SlotForgeTelemetry-${version}-mac-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility",
      "synopsis": "Slot car gearing and setup calculator",
      "maintainer": "James <thedutchmanjames@gmail.com>",
      "artifactName": "SlotForgeTelemetry-${version}-linux-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "SlotForgeTelemetry-${version}-windows-${arch}-Portable.${ext}"
    }
  },
  "homepage": "https://github.com/theDutchmanJames/SlotForgeTelemetry",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theDutchmanJames/SlotForgeTelemetry.git"
  },
  "bugs": {
    "url": "https://github.com/theDutchmanJames/SlotForgeTelemetry/issues"
  },
  "overrides": {
    "@electron/asar": {
      ".": "4.3.1",
      "glob": "14.0.3"
    },
    "@electron/universal": "3.0.6",
    "filelist": "2.0.2",
    "minimatch": "11.0.2"
  }
}
